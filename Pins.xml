<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<Button name="HunterSwingForeverPinTemplate" virtual="true">
		<Size x="18" y="18"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Ring" file="Interface\Buttons\WHITE8X8" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" file="Interface\Icons\INV_Ammo_Arrow_02">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-2"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
					</Anchors>
					<TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Count" inherits="NumberFontNormalSmall">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="5" y="-3"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Hover" file="Interface\Buttons\WHITE8X8" alpha="0.25" setAllPoints="true">
					<Color r="1" g="1" b="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad function="HunterSwingForever_PinOnLoad"/>
			<OnClick function="HunterSwingForever_PinOnClick"/>
			<OnEnter function="HunterSwingForever_PinOnEnter"/>
			<OnLeave function="HunterSwingForever_PinOnLeave"/>
		</Scripts>
	</Button>
</Ui>
